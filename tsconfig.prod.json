{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "composite": true,
    "removeComments": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./server-dist",
    "rootDir": "./server"
  },
"include": ["server/index.ts", "server/routes.ts", "server/static.ts", "server/routes-persistence-fixed.ts"],
  "exclude": ["node_modules", "dist", "server-dist"]
}

